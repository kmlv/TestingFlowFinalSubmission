@article{Brogaard2015a,
abstract = {High-frequency trading (HFT) firms have been shown to influence market quality by exploiting a speed advantage. Using a firm-identified limit-order book dataset we show it is also competition among HFT that influences market quality, and we evaluate the trading dynamics through which the influence occurs. HFT entrants (exiters) increase (decrease) liquidity and improve (harm) price efficiency. In markets with fewer incumbents the impacts are larger. We observe specific behavioral changes consistent with competitive pressure: After Passive HFT entry (exit), incumbent HFT spreads tighten (widen). After Aggressive HFT entry, incumbent order flow loses informedness. HFT trading revenue suggests competition reduces the profitability of HFT. The results show that part of the value of HFT comes from its competitiveness.},
