title = {THE BIGGEST AUCTION EVER: THE SALE OF THE BRITISH 3G TELECOM LICENCES},
journal = {The Economic Journal},
volume = {112},
number = {478},
pages = {C74-C96},
doi = {https://doi.org/10.1111/1468-0297.00020},
