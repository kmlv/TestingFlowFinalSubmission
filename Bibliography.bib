@article{Degryse2022,
   abstract = {Should regulators mandate priority rules in trading? While regulators often require price priority, they do not mandate secondary priority rules. We compare two well-established priority rules (i.e., price-broker-time priority (PBT) and price-time priority (PT)) in a market with a price grid. The applied priority rule determines limit order's execution probability, and hence investors' choice between limit and market orders. When the tick is tight relative to investors' dispersion in valuations, trading rates are higher with PBT relative to PT whereas the opposite holds for wide ticks. The social optimum prescribes PT when the tick is small but PBT for wide ticks. Our model has empirical and regulatory implications regarding market fragmentation.},
   author = {Hans Degryse and Nikolaos Karagiannis},
   title = {Priority Rules},
   url = {https://ssrn.com/abstract=3186009},
   year = {2022},
   journal = {C.E.P.R. Discussion Papers},
}


@article{Du2017,
abstract = {This paper studies the impact of increasing trading frequency in financial markets on allocative efficiency. We build and solve a dynamic model of sequential double auctions in which traders trade strategically with demand schedules. Trading needs are generated by time-varying private information of the asset value and private values for owning the asset, as well as quadratic inventory costs. We characterize a linear equilibrium with stationary strategies and its efficiency properties in closed form. Infrequent trading (few double auctions per unit of time) leads to higher volume of beneficial trades in each double auction, but frequent trading allows more immediate asset reallocation after new information arrives. To maximize allocative efficiency, the optimal trading frequency coincide with the information arrival frequency for scheduled information releases, but can far exceed the information arrival frequency for stochastic information arrivals. A simple calibration suggests that the optimal trading frequency for liquid futures contracts and stocks is in the order of milliseconds per auction, whereas some very illiquid stocks have an optimal trading frequency in the order of seconds or minutes per auction.},
author = {Du, Songzi and Zhu, Haoxiang},
file = {:Users/ealdrich/Dropbox/Academics/Articles/du-zhu-2017.pdf:pdf},
journal = {Review of Economic Studies},
title = {{What is the Optimal Trading Frequency in Financial Markets?}},
year = {2017}
}


@article{Easly2012,
    author = {Easley, David and López de Prado, Marcos M. and O'Hara, Maureen},
    title = "{Flow Toxicity and Liquidity in a High-frequency World}",
    journal = {The Review of Financial Studies},
    volume = {25},
    number = {5},
    pages = {1457-1493},
    year = {2012},
    month = {03},
    abstract = "{Order flow is toxic when it adversely selects market makers, who may be unaware they are providing liquidity at a loss. We present a new procedure to estimate flow toxicity based on volume imbalance and trade intensity (the VPIN toxicity metric). VPIN is updated in volume time, making it applicable to the high-frequency world, and it does not require the intermediate estimation of non-observable parameters or the application of numerical methods. It does require trades classified as buys or sells, and we develop a new bulk volume classification procedure that we argue is more useful in high-frequency markets than standard classification procedures. We show that the VPIN metric is a useful indicator of short-term, toxicity-induced volatility.}",
    issn = {0893-9454},
    doi = {10.1093/rfs/hhs053},
    url = {https://doi.org/10.1093/rfs/hhs053},
    eprint = {https://academic.oup.com/rfs/article-pdf/25/5/1457/24431542/hhs053.pdf},
}





